generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  boards   Board[]
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Board {
  id    String @id @default(cuid())
  title String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  columns Column[]
}

model Column {
  id       String @id @default(cuid())
  title    String
  position Float

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]
}

model Card {
  id       String @id @default(cuid())
  title    String
  position Float

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
}